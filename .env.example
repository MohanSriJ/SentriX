# SentriX Platform Configuration
PROJECT_NAME="SENTRIX Safe-Node Intelligence Platform"
TAGLINE="Sense. Predict. Respond."

# Security
SECRET_KEY=sentrix-hyper-secure-jwt-secret-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./sentrix.db
# For PostgreSQL:
# DATABASE_URL=postgresql://sentrix_user:sentrix_pass@localhost:5432/sentrix_db

# Sensor Thresholds
TEMP_WARNING=40.0
TEMP_CRITICAL=50.0

VIB_WARNING=0.50
VIB_CRITICAL=0.80

GAS_WARNING=25.0
GAS_CRITICAL=50.0

NOISE_WARNING=75.0
NOISE_CRITICAL=90.0

BATTERY_WARNING=30.0
BATTERY_CRITICAL=15.0

# Node Heartbeats & Timeouts (seconds)
OFFLINE_WARNING_SEC=30
OFFLINE_CRITICAL_SEC=120
OFFLINE_DEAD_SEC=300
ALERT_ESCALATION_SEC=120

# Campus Geo Anchor
CAMPUS_CENTER_LAT=13.0827
CAMPUS_CENTER_LNG=80.2707

# Simulation Engine
SIMULATION_ENABLED=True
SIMULATION_INTERVAL_SEC=2.5
SIMULATION_NODES_COUNT=25
